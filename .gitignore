# Git 忽略规则说明：https://help.github.com/articles/ignoring-files/

# 依赖文件
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 测试覆盖率报告
/coverage

# Next.js 和 vinext 构建产物
/.next/
/.vinext/
/out/

# 系统杂项与私钥文件
.DS_Store
*.pem

# 调试日志
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 本地环境配置不提交，仅保留可公开的配置示例。
.env*
!.env.example

# Sites 本地部署配置，包含私人项目标识。
/.openai/hosting.json

# Word 原稿仅在本地保留，仓库上传对应的 Markdown 说明书。
/德州扑克升盲与积分规则说明书.docx

# Vercel 本地配置
.vercel

/dist/
/.wrangler/
/outputs/
/work/
/.site-build.tar.gz
/.codex-docx-qa/
/docx_render_check*/
/build_poker_rules_manual.py
*.tsbuildinfo

# Android TV 本地配置与构建产物
/android-tv/.gradle/
/android-tv/local.properties
/android-tv/app/build/
/android-tv/build/
/android-tv/*.apk
/android-tv/*.idsig
